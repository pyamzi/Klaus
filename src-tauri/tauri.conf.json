{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klaus",
  "version": "0.1.0",
  "identifier": "ink.klaus.app",
  "build": {
    "frontendDist": "../build",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/": "web/",
      "../vendor/anki/out/sveltekit/": "anki-web/",
      "../vendor/anki/out/klaus/": "anki-static/"
    }
  }
}
